  "keywords": [
    "terminal",
    "pty",
    "conpty",
    "web-terminal",
    "xterm",
    "claude",
    "codex",
    "reasonix",
    "opencode",
    "ai-agent",
    "repl",
    "session-manager"
  ],
  "homepage": "https://github.com/vitaldb/webpty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitaldb/webpty.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "webpty": "bin/webpty.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js"
  },
  "files": [
    "src",
    "public",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  }
}
